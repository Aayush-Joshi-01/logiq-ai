{
  "functions": {
    "api/ai/stream.ts": {
      "runtime": "edge"
    },
    "api/ai/*.ts": {
      "maxDuration": 30
    },
    "api/ai/quiz/section.ts": {
      "maxDuration": 30
    },
    "api/courses/index.ts": {
      "maxDuration": 15
    },
    "api/courses/[id].ts": {
      "maxDuration": 15
    },
    "api/subscription/webhook.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PATCH, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization, Content-Type, X-BYOK-Key, X-User-Language, X-User-Level"
        }
      ]
    }
  ]
}
